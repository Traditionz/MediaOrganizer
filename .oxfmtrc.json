{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"useTabs": true,
	"singleQuote": true,
	"trailingComma": "none",
	"printWidth": 100,
	"sortPackageJson": false,
	"sortTailwindcss": true,
	"svelte": true,
	"ignorePatterns": [
		"node_modules",
		".svelte-kit",
		"build",
		"data",
		"bun.lock",
		"pnpm-lock.yaml",
		"package-lock.json",
		"tools"
	]
}
