# Public UI defaults (safe to expose to the browser).
# Copy to `.env` or `.env.local` and restart `npm run dev`.

# grid | collage
PUBLIC_DEFAULT_VIEW_MODE=collage

# 2–8
PUBLIC_DEFAULT_COLUMNS=8

# true | false
PUBLIC_DEFAULT_SHOW_IMAGES=true
PUBLIC_DEFAULT_SHOW_VIDEOS=true

# unassigned | all
PUBLIC_DEFAULT_ALBUM_VIEW=unassigned

# true | false — localStorage `mo_compress` overrides after the user toggles
PUBLIC_DEFAULT_COMPRESS_ON_UPLOAD=true

# true | false — ask before uploading files whose names already exist
# localStorage `mo_warn_dupes` overrides after the user toggles
PUBLIC_DEFAULT_WARN_DUPLICATE_UPLOADS=true

# light | dark | system
PUBLIC_DEFAULT_THEME=system

# Parallel upload slots (1–8)
PUBLIC_UPLOAD_CONCURRENCY=4

# SQLite + files still live under ./data/ (server-only; not configured here).
