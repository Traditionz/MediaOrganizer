{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Media Organizer",
	"version": "0.0.1",
	"identifier": "com.mediaorganizer.app",
	"build": {
		"beforeDevCommand": "bun run dev -- --host 127.0.0.1 --port 1420 --strictPort",
		"devUrl": "http://127.0.0.1:1420",
		"beforeBuildCommand": "bun run build && bun run scripts/prepare-tauri-resources.ts",
		"frontendDist": "./frontend-dist"
	},
	"app": {
		"windows": [],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"resources": ["resources/server", "resources/data/.gitkeep"]
	},
	"plugins": {
		"shell": {
			"open": true
		}
	}
}
