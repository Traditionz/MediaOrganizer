{
	"name": "mediaorganizer",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "bun@1.4.0",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"reinstall": "bun install --ignore-scripts && bun run prepare && bun node_modules/ffmpeg-static/install.js",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "oxlint .",
		"format": "oxfmt",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio"
	},
	"devDependencies": {
		"@oxlint/plugins": "1.78.0",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/better-sqlite3": "^9.6.0",
		"@types/ffmpeg-static": "^3.0.3",
		"@types/node": "^26.2.0",
		"drizzle-kit": "^0.31.10",
		"oxfmt": "^0.64.0",
		"oxlint": "1.78.0",
		"svelte": "^5.56.9",
		"svelte-check": "^4.7.5",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.2.1"
	},
	"dependencies": {
		"@lucide/svelte": "^1.31.0",
		"better-sqlite3": "^13.0.3",
		"daisyui": "^5.7.16",
		"drizzle-orm": "^0.45.2",
		"ffmpeg-static": "^5.3.0",
		"sharp": "^0.35.3"
	}
}
