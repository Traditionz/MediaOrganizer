{
	"name": "mediaorganizer",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "bun@1.4.2",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node build",
		"prepare": "svelte-kit sync || echo ''",
		"reinstall": "bun install && bun run prepare",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.app.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.app.json --watch",
		"lint": "oxlint .",
		"format": "oxfmt .",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio",
		"test": "bun test src test scripts",
		"test:coverage": "bun test src test scripts --coverage",
		"test:components": "vitest run",
		"test:components:coverage": "vitest run --coverage",
		"test:all": "bun test src test scripts && vitest run",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:install": "playwright install chromium",
		"check:test": "tsc -p tsconfig.test.json --noEmit",
		"tauri": "tauri",
		"tauri:dev": "tauri dev",
		"tauri:build": "tauri build"
	},
	"devDependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@internationalized/date": "^3.12.0",
		"@oxlint/plugins": "^1.80.0",
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@tauri-apps/api": "2",
		"@tauri-apps/cli": "2",
		"@types/better-sqlite3": "^9.6.0",
		"@types/ffmpeg-static": "^3.0.3",
		"@types/node": "^26.3.0",
		"@vitest/browser": "^5.0.1",
		"@vitest/browser-playwright": "^5.0.1",
		"@vitest/coverage-v8": "^5.0.1",
		"bits-ui": "^2.16.3",
		"bun-types": "1.4.2",
		"clsx": "^2.1.1",
		"drizzle-kit": "^0.31.10",
		"oxfmt": "^0.65.0",
		"oxlint": "^1.80.0",
		"shadcn-svelte": "^1.5.0",
		"svelte": "^5.56.9",
		"svelte-check": "^4.7.5",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.2.1",
		"vitest": "^5.0.1",
		"vitest-browser-svelte": "^3.1.0"
	},
	"dependencies": {
		"@lucide/svelte": "^1.34.0",
		"better-sqlite3": "^13.0.3",
		"drizzle-orm": "^0.45.2",
		"ffmpeg-static": "^5.3.0",
		"sharp": "^0.35.3"
	}
}
